# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments
.venv/
.env

# Toolset UI views: node deps and built bundles (rebuilt by the Dockerfile's
# node stage / `npm run build`; served from <package>/views/ at runtime).
toolsets/*/ui/node_modules/
toolsets/*/src/*/views/

