# Copy to .env (gitignored) and fill in. Read by the agent API
# (uv run uvicorn agent_app:app) and the terminal chat (uv run mcp-agent) via
# pydantic-settings. The file is found relative to the working directory —
# start these commands from the repo root.

# --- Chat model (agent API / mcp-agent) -----------------------------------
# Required. provider:model string for langchain.init_chat_model. This repo
# installs the Mistral provider; for another, install its package, e.g.:
#   PROVIDER_MODEL=openai:gpt-4o-mini                 + uv add langchain-openai
#   PROVIDER_MODEL=anthropic:claude-3-5-haiku-latest  + uv add langchain-anthropic
#   PROVIDER_MODEL=mistralai:mistral-small-latest     (already installed)
PROVIDER_MODEL=mistralai:mistral-small-latest
# Required. API key for the provider selected above.
PROVIDER_API_KEY=

# Which MCP endpoint the agent talks to. An index root gives the agent all
# toolsets — `mcp-serve-local` serves the index at / and each toolset at
# /<name>/mcp. Point at a single server's /mcp only for a bare `mcp-serve`.
MCP_URL=http://localhost:8000/

# --- Agent API (uv run uvicorn agent_app:app --port 8765) ------------------
# The API uses the PROVIDER_* and MCP_URL values above. Optional overrides:
# MCP_AGENT_CHECKPOINT=memory   # default; or a postgres:// URL for durable threads
# MCP_AGENT_STATE=1             # 0 disables session state
# MCP_AGENT_API_CORS_ORIGINS=   # unset = no CORS; the bundled web client needs none

# --- Image interpretation (naip-imagery's interpret_image) ----------------
# A vision model served by Ollama. The default is an Ollama cloud model, so no
# GPU is needed: run `ollama signin && ollama pull gemma4:cloud` once.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_IMAGE_MODEL=gemma4:cloud

# --- Logging --------------------------------------------------------------
# Verbose logging for local MCP servers (mcp-serve / mcp-serve-local): every
# SQL statement, parameters, timings and row counts. The toolset reads
# LOG_LEVEL (falling back to FASTMCP_LOG_LEVEL, which also drives FastMCP
# and uvicorn); deployed pods carry no .env, so this is local-only unless
# the same variable is set in toolset.yaml.
LOG_LEVEL=DEBUG
